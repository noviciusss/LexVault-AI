# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lexvault
DATABASE_URL_SYNC=postgresql://postgres:postgrespassword@localhost:5432/lexvault

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexvaultpassword

# Ollama Local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Groq API (High-speed legal strategy abstraction & RAG synthesis)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
JWT_SECRET=lexvault-super-secret-jwt-key-for-capstone-demo-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000
